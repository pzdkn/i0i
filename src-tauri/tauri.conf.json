{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "i0i",
  "version": "0.1.0",
  "identifier": "com.i0i.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/prepare_runtime.mjs && pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "i0i",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "resources": [
      "resources/THIRD_PARTY_NOTICES.md",
      "resources/pdfium/libpdfium.dylib",
      "resources/obscura/obscura",
      "resources/obscura/obscura-worker"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
